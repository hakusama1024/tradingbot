# Base/shared environment.
# Copy values you want shared by all profiles into `.env`.
# Profile-specific secrets and runtime settings should go in `profiles/<name>/.env`.

# LLM providers
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# Optional market/news provider
ALPHA_VANTAGE_API_KEY=

# Shared defaults
TRADING_UNIVERSE=broad
OVERLAY_ENABLED=0
INTRADAY_INTERVAL_MINUTES=10

# Shared notifications
NTFY_ENABLED=0
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
SOCIAL_MONITOR_ENABLED=0
SOCIAL_MONITOR_USERNAMES=markminervini
SOCIAL_CHECK_INTERVAL_MINUTES=2
SOCIAL_NTFY_ENABLED=0
SOCIAL_NTFY_TOPIC=

# Optional shared market data store
# MINERVINI_DB_PATH=/absolute/path/to/research_data/market_data.duckdb

# TradingAgents paper_stockscan profile
#
# Purpose:
#   Satellite stock scanner for the main paper Alpaca account.
#   It restores the 10-minute broad-market Minervini/leader-continuation scan
#   while the paper TriCore/SMH rotation service keeps running separately.
#
# Secrets:
#   Do not commit real API keys. Put real keys only in profiles/paper_stockscan/.env.

PAPER_TRADING=1
EXECUTION_ENABLED=1
ALPACA_API_KEY=your_alpaca_paper_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_here

TRADING_RUNTIME_ROOT=./runtime/paper_stockscan
TRADING_DB_PATH=./runtime/paper_stockscan/trading.db
RESULTS_DIR=./runtime/paper_stockscan/results
TRADING_LOG_PATH=./runtime/paper_stockscan/trading.log
TRADING_SERVICE_LABEL=com.tradingagents.scheduler.paper_stockscan

NTFY_ENABLED=1
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=your_ntfy_topic_here
NTFY_PRIORITY=default
NTFY_TAGS=chart_with_upwards_trend,moneybag

TRADING_UNIVERSE=broad
BROAD_MARKET_MAX_CANDIDATES=160
BROAD_MARKET_MAX_SEED_SYMBOLS=600
SELECTION_STRATEGY=minervini
MINERVINI_DB_PATH=./runtime/paper_stockscan/stockscan_data.duckdb

OVERLAY_ENABLED=0
OVERLAY_SYMBOL=SMH
OVERLAY_TRIGGER=confirmed_uptrend
OVERLAY_FRACTION=1.0
OVERLAY_REBALANCE_THRESHOLD_PCT=0.03
OVERLAY_MIN_NOTIONAL=500
OVERLAY_MAX_TOTAL_EXPOSURE=1.0
OVERLAY_CONTEXT_SYMBOLS=SPY,QQQ,IWM,SMH,^VIX

INTRADAY_INTERVAL_MINUTES=10
MAX_OPEN_POSITIONS=8
MIN_CASH_RESERVE=0.00
MAX_TOTAL_EXPOSURE=1.25
MINERVINI_TARGET_EXPOSURE_CONFIRMED_UPTREND=1.25
MINERVINI_TARGET_EXPOSURE_UPTREND_UNDER_PRESSURE=0.72
LEADER_CONTINUATION_TARGET_EXPOSURE_CONFIRMED_UPTREND=1.25
LEADER_CONTINUATION_TARGET_EXPOSURE_UPTREND_UNDER_PRESSURE=0.72

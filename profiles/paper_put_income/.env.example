# TradingAgents paper_put_income profile
#
# Purpose:
#   Isolated paper simulation profile for Quality Put Income v1.
#   It scans live option chains and records simulated cash-secured put trades.
#   It does not submit Alpaca option orders yet.
#
# Secrets:
#   Do not commit real API keys. Put real keys only in profiles/paper_put_income/.env
#   if/when broker-side options execution is wired.

PAPER_TRADING=1
EXECUTION_ENABLED=0

# Runtime isolation
TRADING_RUNTIME_ROOT=./runtime/paper_put_income
TRADING_DB_PATH=./runtime/paper_put_income/trading.db
RESULTS_DIR=./runtime/paper_put_income/results
TRADING_LOG_PATH=./runtime/paper_put_income/trading.log
TRADING_SERVICE_LABEL=com.tradingagents.scheduler.paper_put_income

# Quality Put Income v1
# Current implementation is local paper simulation from live option-chain mids.
SELECTION_STRATEGY=quality_put_income_v1
PUT_INCOME_SYMBOLS=SPY,QQQ,AAPL,MSFT,GOOGL,AMZN,META,COST,JPM,V,MA,ORCL,SNOW,AMD,INTC,CSCO,GILD,MRK,PFE,KO,BAC,C,WMT,UBER,DIS,NKE,PYPL
PUT_INCOME_STARTING_EQUITY=100000
PUT_INCOME_ENTRY_DTE=45
PUT_INCOME_MANAGE_DTE=21
PUT_INCOME_MIN_DELTA=0.16
PUT_INCOME_TARGET_DELTA=0.25
PUT_INCOME_MAX_DELTA=0.30
PUT_INCOME_MIN_IV=0.20
PUT_INCOME_MIN_PREMIUM_YIELD=0.010
PUT_INCOME_CLOSE_PROFIT_PCT=0.50
PUT_INCOME_MAX_LOSS_MULTIPLE=2.50
PUT_INCOME_MAX_SYMBOL_NOTIONAL_PCT=0.20
PUT_INCOME_MAX_TOTAL_NOTIONAL_PCT=0.85
PUT_INCOME_MAX_OPEN_POSITIONS=5
PUT_INCOME_MAX_CONTRACTS_PER_SYMBOL=2
PUT_INCOME_MIN_OPEN_INTEREST=100
PUT_INCOME_MIN_OPTION_VOLUME=0
PUT_INCOME_HIGH_IV_THRESHOLD=0.55
PUT_INCOME_HIGH_IV_SYMBOL_CAP_PCT=0.10
PUT_INCOME_CASH_YIELD=0.035

# Notifications
NTFY_ENABLED=1
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=your_ntfy_topic_here
PUT_INCOME_NTFY_ENABLED=1

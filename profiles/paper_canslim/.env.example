# TradingAgents CAN SLIM + Minervini paper profile

PAPER_TRADING=1
EXECUTION_ENABLED=1

# Paper Alpaca account
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Runtime isolation
TRADING_RUNTIME_ROOT=/Users/test/Code/TradingAgents/runtime/paper_canslim
TRADING_DB_PATH=/Users/test/Code/TradingAgents/runtime/paper_canslim/trading.db
RESULTS_DIR=/Users/test/Code/TradingAgents/runtime/paper_canslim/results
TRADING_LOG_PATH=/Users/test/Code/TradingAgents/runtime/paper_canslim/trading.log
TRADING_SERVICE_LABEL=com.tradingagents.scheduler.paper_canslim

# Strategy
TRADING_UNIVERSE=broad
SELECTION_STRATEGY=canslim_minervini
CANSLIM_MIN_SCORE=4
CANSLIM_REQUIRE_FUNDAMENTALS=1
CANSLIM_REQUIRE_NEW_HIGH_SIGNAL=1
CANSLIM_REQUIRE_LEADER_SIGNAL=1
CANSLIM_REQUIRE_VOLUME_SIGNAL=0

# Risk / deployment
OVERLAY_ENABLED=1
OVERLAY_SYMBOL=SMH
OVERLAY_TRIGGER=confirmed_uptrend
OVERLAY_FRACTION=1.0
OVERLAY_MAX_TOTAL_EXPOSURE=1.0
MIN_CASH_RESERVE=0.00
MAX_TOTAL_EXPOSURE=1.25

# Notifications
NTFY_ENABLED=1
NTFY_TOPIC=
SOCIAL_MONITOR_ENABLED=0
